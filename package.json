  "description": "Mobile-first PWA and real-time live monitoring dashboard for autonomous AI coding agents",
  "main": "dist/server/server.js",
  "types": "dist/server/server.d.ts",
  "bin": {
    "agent-monitor": "./dist/cli.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
