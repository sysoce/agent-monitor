  },
  "homepage": "https://sysoce.github.io/agent-monitor/",
  "devDependencies": {
    "@types/node": "^20.17.19",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
